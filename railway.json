{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install"
  },
  "deploy": {
    "startCommand": "node bot.js",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 100,
    "sleepApplication": false,
    "healthcheckPath": null
  }
}
